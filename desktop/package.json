{
  "name": "cloudworkbench-desktop",
  "version": "1.0.0",
  "description": "云记事板桌面版 - 透明置顶悬浮窗",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "node scripts/prebuild.js",
    "build": "npm run prebuild && electron-builder",
    "build:win": "npm run prebuild && electron-builder --win",
    "build:mac": "npm run prebuild && electron-builder --mac",
    "build:linux": "npm run prebuild && electron-builder --linux"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/intp41455/notebook.git",
    "directory": "desktop"
  },
  "build": {
    "appId": "com.cloudworkbench.desktop",
    "productName": "云记事板",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-float.js",
      "float.html",
      "app/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      "start.bat",
      "start.command",
      "start.sh",
      "README.md"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Office"
    }
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^25.0.0",
    "jimp": "^1.6.1"
  }
}
